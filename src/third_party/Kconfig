menu "Third-Party Components"

config LIST
	bool "Enable linked list (list.h)"
	default n
	help
	  Provides list_head, hlist_head, container_of macros.
	  Zero dependency, header-only library.

config WORKQUEUE
	bool "Enable MCU workqueue (based on list.h)"
	default n
	select LIST
	help
	  Simplified workqueue for MCU.
	  Supports delayed execution, FIFO scheduling.
	  Requires LIST to be enabled(auto).

config HEXDUMP
	bool "Enable hexdump memory dump command"
	default n
	help
	  Provides 'hexdump' command for embedded memory/flash debugging.
	  Supports configurable address range, bytes per line,
	  and ASCII output.

config HEXDUMP_MIN_ADDR
	hex "Default minimum valid address"
	depends on HEXDUMP
	default 0x08000000
	help
	  Lower bound of the valid address range.
	  Default to STM32F103C8T6 Flash start address.

config HEXDUMP_MAX_ADDR
	hex "Default maximum valid address"
	depends on HEXDUMP
	default 0x0800FFFF
	help
	  Upper bound of the valid address range.
	  Default to STM32F103C8T6 Flash end address (64KB).

config HEXDUMP_BYTES_PER_LINE
	int "Default bytes per line"
	depends on HEXDUMP
	default 16
	range 1 64
	help
	  Number of bytes printed on each line.

config HEXDUMP_MAX_LEN
	int "Maximum bytes per dump"
	depends on HEXDUMP
	default 256
	range 1 4096
	help
	  Maximum number of bytes allowed in a single hexdump command.

endmenu
